<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".View.ReservationActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Date and Time Information -->
            <TextView
                android:id="@+id/reservationDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Randevu Tarihi: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/reservationTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Randevu Saati: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <!-- Total Price Information -->
            <TextView
                android:id="@+id/totalPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toplam Ücret: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="16dp" />

            <!-- Card Number Input -->
            <EditText
                android:id="@+id/cardNumberInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Kart Numarası"
                android:inputType="number"
                android:maxLength="19"
                android:padding="12dp"
                android:background="@drawable/edittext_background"
                android:focusable="true"
                android:focusableInTouchMode="true"/>

            <!-- Expiration Date and CVV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <EditText
                    android:id="@+id/expirationDateInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Son Kullanma Tarihi (MM/YY)"
                    android:inputType="number"
                    android:maxLength="5"
                    android:padding="12dp"
                    android:background="@drawable/edittext_background"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <EditText
                    android:id="@+id/cvvInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="CVV"
                    android:inputType="number"
                    android:maxLength="3"
                    android:padding="12dp"
                    android:background="@drawable/edittext_background"
                    android:layout_marginStart="16dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </LinearLayout>

            <!-- Cardholder Name Input -->
            <EditText
                android:id="@+id/cardHolderNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Kart Sahibinin Adı"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/edittext_background"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Payment Button -->
            <Button
                android:id="@+id/payButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ödemeyi Tamamla"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                android:background="@color/green"
                android:textColor="@android:color/white" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
